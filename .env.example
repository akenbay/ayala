# Language model. Default provider is OpenAI (ChatGPT models).
# Without a key the app runs on code checks only ("Quick mode").
OPENAI_API_KEY=
# Model name from your OpenAI dashboard. Default: gpt-5.6-luna (fast, low cost tier).
LLM_MODEL=
# Optional alternative provider: set LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY.
LLM_PROVIDER=
ANTHROPIC_API_KEY=

# Stripe TEST secret key (sk_test_...). Without it, "Get Plus" unlocks in demo mode.
STRIPE_SECRET_KEY=
